# Knova Frontend – copy to .env.local and fill in
# Backend API base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000

# Gemini API key for AI features (course content, tutor, speech, etc.)
# Either variable works; both are exposed to the app via vite.config.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Optional: fallback in Settings (stored in localStorage)
# Users can also enter key in app Settings instead of env.
